import pandas as pd
import sqlite3

# 1. read the cleaned data CSV
df = pd.read_csv('seo_data_final.csv')

# 2. Connect to the SQLite database
conn = sqlite3.connect('seo_analytics.db')
cursor = conn.cursor()

# 3. input the data into traffic_data form of the database
# if_exists='replace' means that if the table already exists, it will be overwritten, 
# and index=False means the pandas index will not be included as a column.
df.to_sql('traffic_data', conn, if_exists='replace', index=False)

# 4. Verify whether the data is sucessfully imported
cursor.execute("SELECT COUNT(*) FROM traffic_data;")
row_count = cursor.fetchone()[0]
print(f"🎉 Successfully created the local SQLite database!'traffic_data' The data has {row_count} rows")

# 关闭连接
conn.close()
